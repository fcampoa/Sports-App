# Normaliza finales de línea a LF en el repo (evita diffs falsos entre Windows y Linux/CI)
* text=auto eol=lf

# Scripts de Windows conservan CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.parquet binary
*.woff2 binary

# Archivos generados: no mostrar en diffs de PR
uv.lock linguist-generated=true -diff
pnpm-lock.yaml linguist-generated=true -diff
apps/web/src/api/** linguist-generated=true
